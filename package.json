{
	"name": "drawify",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve --port 4300",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"serve:ssr:drawify": "node dist/drawify/server/server.mjs",
		"test:unit": "ng test --watch=false",
		"test:e2e": "playwright test",
		"build:vercel": "ng build && node scripts/vercel-output.mjs",
		"test:deployment": "node scripts/verify-vercel.mjs",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "npm run lint -- --fix",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"check": "npm run format:check && npm run lint && npm run test:unit && npm run build"
	},
	"private": true,
	"packageManager": "npm@11.17.0",
	"dependencies": {
		"@angular/common": "^22.2.0",
		"@angular/compiler": "^22.2.0",
		"@angular/core": "^22.2.0",
		"@angular/forms": "^22.2.0",
		"@angular/platform-browser": "^22.2.0",
		"@angular/platform-server": "^22.2.0",
		"@angular/router": "^22.2.0",
		"@angular/ssr": "^22.2.3",
		"@lucide/angular": "^1.59.0",
		"express": "^5.1.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular/build": "^22.2.3",
		"@angular/cli": "^22.2.3",
		"@angular/compiler-cli": "^22.2.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4.1.12",
		"@types/express": "^5.0.1",
		"@types/node": "24.19.2",
		"angular-eslint": "22.6.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.13.0",
		"jsdom": "^30.0.0",
		"postcss": "^8.5.3",
		"prettier": "3.9.10",
		"tailwindcss": "^4.1.12",
		"typescript": "~6.0.2",
		"typescript-eslint": "8.71.0",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=24.19.0 <25",
		"npm": ">=11.17.0 <12"
	}
}
